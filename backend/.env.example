GOOGLE_API_KEY=your_google_api_key_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/focusflow
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret-key-in-production
DEBUG=True
GEMINI_MODEL=gemini-2.0-flash
CHROMA_PERSIST_DIR=./chroma_data
UPLOAD_DIR=./uploads

# Gmail Notifications (use an App Password, not your real Gmail password)
# Steps: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
